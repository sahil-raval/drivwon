# Public site origin, including https:// in production. Used for canonicals and the sitemap.
APP_URL=https://drivwon.com

# Server runtime only. Supply through Replit Secrets or your hosting provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://drivwon.com/api/auth/google/callback
GOOGLE_ALLOWED_EMAILS=owner@example.com,teammate@example.com
# Use this instead of listing each email only if every member of the domain may access finance records.
# GOOGLE_ALLOWED_DOMAINS=your-workspace-domain.com

# Public Google API key. Restrict by website origin and to the Google Picker API.
VITE_GOOGLE_PICKER_API_KEY=

# Public URL for the separately hosted, Sanity-authenticated Studio.
VITE_SANITY_STUDIO_URL=https://drivwon.sanity.studio
