# ─────────────────────────────────────────────────────────────────────────────
# Drivwon environment variables
# 1. Copy this file to .env   (or run: npm run setup)
# 2. Fill in the values you need. Never commit .env — it is git-ignored.
# Variables starting with VITE_ or SANITY_STUDIO_ are PUBLIC (sent to the browser).
# Never put a token or password in a VITE_ / SANITY_STUDIO_ variable.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sanity CMS ───────────────────────────────────────────────────────────────
# Project ID and dataset (public, safe to share).
SANITY_PROJECT_ID=v6luawxh
SANITY_DATASET=production
# Same values for the website in the browser.
VITE_SANITY_PROJECT_ID=v6luawxh
VITE_SANITY_DATASET=production
# Same values for Sanity Studio (npm run studio / npm run sanity:deploy).
SANITY_STUDIO_PROJECT_ID=v6luawxh
SANITY_STUDIO_DATASET=production
# Hosted Studio URL (used by the /studio link page).
VITE_SANITY_STUDIO_URL=https://drivwon.sanity.studio

# SECRET. Sanity Editor token used by the server to save form leads (private docs).
# Create it at https://www.sanity.io/manage/project/v6luawxh/api → Tokens → Add API token → Editor.
SANITY_LEADS_TOKEN=
# SECRET. Editor token used only when you run: npm run sanity:seed
# (You can reuse SANITY_LEADS_TOKEN — the seed script falls back to it.)
SANITY_WRITE_TOKEN=

# ── Website ──────────────────────────────────────────────────────────────────
# Live site origin. Used for canonical URLs, sitemap and schema. No trailing slash.
APP_URL=https://www.drivwon.com.au
# Local dev port (npm run dev → http://localhost:5173)
PORT=5173

# ── Lead alerts (optional) ───────────────────────────────────────────────────
# Email every new lead with Resend (https://resend.com). SECRET key.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=info@drivwon.com
LEAD_FROM_EMAIL=Drivwon website <leads@drivwon.com>
# Send every lead as JSON to Zapier / Make / your CRM.
LEAD_WEBHOOK_URL=

# ── Private workspace /drivwon/der (optional for local dev) ──────────────────
# Leave DATABASE_URL empty and the private dashboard is simply turned off.
DATABASE_URL=
# SECRET. Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# SECRET. At least 16 characters.
DRIVWON_ADMIN_PASSWORD=

# Google Drive for the workspace (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.drivwon.com.au/api/auth/google/callback
GOOGLE_ALLOWED_EMAILS=info@drivwon.com
# GOOGLE_ALLOWED_DOMAINS=drivwon.com
# Public Google API key, restricted to your website origin and the Google Picker API.
VITE_GOOGLE_PICKER_API_KEY=
